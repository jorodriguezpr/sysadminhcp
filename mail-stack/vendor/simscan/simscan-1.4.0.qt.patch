+/* 
+ * check for a string match starting at the end of the string 
+ */
+int str_rstr(register char *h,register char *n)
+{
+ register char *sh;
+ register char *sn;
+
+  for(sh=h;*h!=0;++h); --h;
+  for(sn=n;*n!=0;++n); --n;
+
+  for(;h>=sh && n>=sn;--h,--n) {
+    if ( *h!=*n ) {
+      return(-1);
+    }
+  }
+  return(0);
+}
