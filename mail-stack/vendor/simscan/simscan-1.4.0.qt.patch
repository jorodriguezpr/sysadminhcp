+char *strsep (char **pp, char *delim) 
+{
+ char *p, *q;
+
+  if (!(p = *pp)) return 0;
+  if ((q = strpbrk (p, delim))) {
+      *pp = q + 1;
+      *q = '\0';
+  } else {
+    *pp = 0;
+  }
